{
  "name": "enclose",
  "productName": "Enclose (Alpha)",
  "desktopName": "enclose",
  "private": true,
  "version": "0.0.16",
  "description": "CAD workbench with a Claude handoff",
  "homepage": "https://enclose.dev",
  "repository": "github:enclosedev/enclose",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "dist": "npm run build && node scripts/dist.mjs",
    "release": "node scripts/release.mjs",
    "icons": "node scripts/icons.mjs",
    "scenes": "node scripts/scenes.mjs",
    "examples": "node scripts/examples.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "sandbox": "node scripts/sandbox.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "dugite": "^3.2.3",
    "electron-updater": "^6.8.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "^4",
    "@tscircuit/alphabet": "0.0.25",
    "@tscircuit/circuit-json-util": "0.0.122",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6",
    "circuit-json": "0.0.528",
    "circuit-json-to-connectivity-map": "0.0.33",
    "circuit-to-svg": "0.0.450",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "schematic-symbols": "0.0.248",
    "shadcn": "^4.21.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "dugite@3.2.3": true
  },
  "overrides": {
    "typescript": "$typescript",
    "@tscircuit/circuit-json-util": {
      "zod": "$zod"
    }
  }
}
